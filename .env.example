# Application Configuration
VITE_APP_NAME=Cânticos CCB
VITE_APP_URL=http://localhost:5173

# Media Storage (VPS)
VITE_MEDIA_BASE_URL=https://canticosccb.com.br/media

# API Backend (PHP)
VITE_API_BASE_URL=https://canticosccb.com.br/api

# Optional: Analytics
VITE_GA_TRACKING_ID=

# Optional: Sentry Error Tracking
# Optional: Sentry Error Tracking
VITE_SENTRY_DSN=

# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://vxzyujmqiqenevoatmgy.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Server-side verification (never expose service role in VITE_* variables)
SUPABASE_URL=https://vxzyujmqiqenevoatmgy.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Only needed by server-side jobs that read protected configuration
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Comma-separated origins allowed by protected server endpoints
CORS_ALLOWED_ORIGINS=https://www.canticosccb.com.br,https://canticosccb.com.br,http://localhost:5173,http://127.0.0.1:5173
# Set true in CI/deploy jobs so incomplete dynamic sitemaps fail the build
SITEMAP_STRICT=false
VITE_MEDIA_PUBLIC_BASE_URL=https://media.canticosccb.com.br
VITE_ENABLE_GOOGLE_AUTH=true

# Cloudflare R2 (server-side uploads)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=canticos-media
R2_PUBLIC_URL=https://media.canticosccb.com.br

# Localhost: assinador R2 na Vercel (Vite não serve /api/*)
# VITE_DEPLOY_ORIGIN=https://www.canticosccb.com.br
# VITE_R2_SIGN_URL=https://www.canticosccb.com.br/api/r2-upload-sign

# YouTube API Configuration (for YouTube Import feature)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here


# Optional: Feature Flags
VITE_ENABLE_PREMIUM=true
VITE_ENABLE_SOCIAL=true
VITE_ENABLE_OFFLINE=true
